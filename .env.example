# ─────────────────────────────────────────────────────────────────────────────
# Chain of Truth — environment configuration
#
# Copy this file to `.env` IN THIS SAME DIRECTORY (the repository root):
#     Copy-Item .env.example .env
#
# `.env` is gitignored and must never be committed. Every secret below is a
# DEVELOPMENT PLACEHOLDER — generate real values before any deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (consumed by docker/docker-compose.yml and the backend) ───────
POSTGRES_USER=cot
POSTGRES_PASSWORD=cot_dev_password
POSTGRES_DB=chain_of_truth
POSTGRES_PORT=5432

# Backend connection string. Host is localhost because the API runs on the host
# while Postgres runs in Docker with port 5432 published.
COT_DATABASE_URL=postgresql+psycopg://cot:cot_dev_password@localhost:5432/chain_of_truth

# ── Object storage (MinIO, S3-compatible) ────────────────────────────────────
MINIO_ROOT_USER=cot_minio_admin
MINIO_ROOT_PASSWORD=cot_minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

COT_S3_ENDPOINT=http://localhost:9000
COT_S3_ACCESS_KEY=cot_minio_admin
COT_S3_SECRET_KEY=cot_minio_dev_password
S3_BUCKET=evidence
COT_S3_BUCKET=evidence
COT_S3_REGION=us-east-1

# Storage backend: "s3" (MinIO) or "local" (filesystem, no Docker needed).
COT_STORAGE_BACKEND=s3
COT_STORAGE_DIR=./storage

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a real secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
COT_JWT_SECRET=CHANGE_ME_generate_a_64_byte_random_secret
COT_JWT_ALGORITHM=HS256
COT_ACCESS_TOKEN_MINUTES=15
COT_REFRESH_TOKEN_DAYS=7

# ── Evidence signing (Ed25519) ───────────────────────────────────────────────
# Generate with: python backend/scripts/make_keys.py
COT_SIGNING_PRIVATE_KEY=
COT_SIGNING_PUBLIC_KEY=

# ── PII encryption at rest (AES-GCM envelope) ────────────────────────────────
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
COT_ENCRYPTION_KEY=CHANGE_ME_base64_32_byte_key

# ── AI provider ──────────────────────────────────────────────────────────────
# "mock"      = deterministic, offline, no API key, no network. Demo-safe default.
# "groq"      = live inference via Groq (OpenAI-compatible). Requires GROQ_API_KEY.
# "anthropic" = live inference via Claude. Requires ANTHROPIC_API_KEY.
#
# If a live provider cannot be reached the system falls back to "mock" and says
# so loudly -- it never silently pretends a rule matched when a model was meant
# to run. Verify with: python backend/scripts/check_ai.py --live
COT_AI_PROVIDER=groq

# Get a key at https://console.groq.com/keys  (free tier is fine for the demo)
GROQ_API_KEY=
# Run `python backend/scripts/check_ai.py --models` to list what your key can use.
COT_GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=

# ── Embeddings (fastembed, runs locally, no API key) ─────────────────────────
COT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COT_EMBEDDING_DIM=384

# ── Evidence integrity rules ─────────────────────────────────────────────────
COT_SHIFT_TOLERANCE_M=2000
COT_MAX_UPLOAD_BYTES=209715200

# ── Frontend ─────────────────────────────────────────────────────────────────
# Also place this in frontend/.env.local for the Next.js dev server.
NEXT_PUBLIC_API_URL=http://localhost:8000
